
{
  "content": "<p>« <a href=\"../../../pages/psychopathology-ii/index.html\">Previous</a></p>\n\n    <h3 id=\"removed-clip-1-woman-with-ocd\">Removed Clip 1: Woman with OCD</h3>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<div class=\"video-embed video-player-wrapper\">\n  \n\n\n\n\n\n\n\n\n\n\n\n\n\n\n  <div class=\"show-offline alert alert-warning\" role=\"alert\">\n    \n    \n      <svg xmlns=\"http://www.w3.org/2000/svg\" height=\"24\" viewBox=\"0 0 24 24\" width=\"24\">\n  <path d=\"M0 0h24v24H0z\" fill=\"none\"/>\n  <path d=\"M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z\" fill=\"#ffffff\"/>\n</svg>\n\n    \n    Viewing videos requires an internet connection\n  </div>\n\n<div class=\"video-container embedded-video-container youtube-container\">\n  <video\n    id=\"video-player-Rn1OYlYzgm8-aca4399c9fc4382a59edc1f6419f05f0\"\n    class=\"video-js vjs-default-skin vjs-big-play-centered vjs-ocw\"\n    controls\n    data-downloadlink = \"\"\n    data-transcriptlink = \"\"\n    \n  >\n      \n  </video>\n</div>\n\n\n\n<script>\n  window.handleVideoJSError = function(err) {\n    console.error('Error loading VideoJS or YouTube player:', err)\n    var youtubeVideoContainers = document.querySelectorAll('.video-container.youtube-container')\n    for (var i = 0; i < youtubeVideoContainers.length; i++) {\n      youtubeVideoContainers[i].style.display = 'none';\n    }\n\n    var fallbackContainers = document.querySelectorAll('.video-fallback-container')\n    for (var j = 0; j < fallbackContainers.length; j++) {\n      fallbackContainers[j].style.display = 'block';\n    }\n  }\n\n  try {\n      new Function(\"class X{#abc;}; 1??2; ({})?.abc\");\n  }\n  catch (e) {\n    window.handleVideoJSError(e)\n  }\n\n  window.addEventListener('load', function() {\n    if (window.initVideoJS) {\n      window.